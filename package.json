{
  "name": "@postward-cc/creative-mcp",
  "version": "0.4.0",
  "description": "Local-first MCP server for video and image editing \u2014 ffmpeg and ImageMagick driven by natural language. 100% offline: no keys, no network calls, no uploads, no account.",
  "license": "MIT",
  "author": "Postward <hello@postward.cc> (https://postward.cc)",
  "homepage": "https://github.com/postward-cc/postward-creative-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/postward-cc/postward-creative-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ffmpeg",
    "video-editing",
    "image-processing",
    "local-first",
    "offline"
  ],
  "type": "module",
  "exports": {
    "./ffmpeg-args": {
      "types": "./dist/ffmpeg-args.d.ts",
      "import": "./dist/ffmpeg-args.js",
      "require": "./dist/ffmpeg-args.cjs"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "creative-mcp": "dist/index.cjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node esbuild.config.mjs && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:package-exports": "node scripts/check-package-exports.mjs",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
