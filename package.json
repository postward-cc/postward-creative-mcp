{
  "name": "@postward-cc/creative-mcp",
  "version": "0.3.0",
  "description": "Local-first MCP server for video and image editing — ffmpeg and ImageMagick driven by natural language. 100% offline: no keys, no network calls, no uploads, no account.",
  "license": "MIT",
  "author": "Postward <hello@postward.cc> (https://postward.cc)",
  "homepage": "https://github.com/postward-cc/postward-creative-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/postward-cc/postward-creative-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ffmpeg",
    "video-editing",
    "image-processing",
    "local-first",
    "offline"
  ],
  "type": "module",
  "exports": {
    "./ffmpeg-args": {
      "types": "./dist/ffmpeg-args.d.ts",
      "import": "./dist/ffmpeg-args.js",
      "require": "./dist/ffmpeg-args.cjs"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "postward-creative-mcp": "dist/index.cjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node esbuild.config.mjs && tsc --declaration --emitDeclarationOnly --noEmit false --target ES2022 --module NodeNext --moduleResolution NodeNext --strict --skipLibCheck --rootDir src/lib --outDir dist src/lib/ffmpeg-args.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:package-exports": "node scripts/check-package-exports.mjs",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
