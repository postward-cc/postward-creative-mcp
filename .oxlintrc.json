{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "promise"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "node": true,
    "es2024": true
  },
  "ignorePatterns": ["dist/**", "node_modules/**"],
  "rules": {
    "no-var": "error",
    "prefer-const": "error",
    "typescript/no-explicit-any": "warn",
    "typescript/no-unused-vars": "error"
  }
}